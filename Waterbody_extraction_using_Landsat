var startDate = '2024';   //1998,2008,2018,2024
var endDate = '2025';
var cloudThreshold = 10;

var landsat5 = ee.ImageCollection('LANDSAT/LT05/C02/T1_L2')
    .filterBounds(aoi)                       // Filter by region of interest
