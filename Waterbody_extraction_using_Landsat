print(landsat5);

var landsat8 = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
    .filterBounds(aoi)                       // Filter by region of interest
    .filterDate(startDate, endDate)          // Filter by date range
    .filter(ee.Filter.lte('CLOUD_COVER', cloudThreshold))
    .filter(ee.Filter.calendarRange(6,10, 'month'));// Landsat 8 SR Collection
    
print(landsat8);

var landsat9 = ee.ImageCollection('LANDSAT/LC09/C02/T1_L2')
    .filterBounds(aoi)                       // Filter by region of interest
    .filterDate(startDate, endDate)          // Filter by date range
    .filter(ee.Filter.lte('CLOUD_COVER', cloudThreshold))
    .filter(ee.Filter.calendarRange(1,12, 'month'));// Landsat 8 SR Collection
    
